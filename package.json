{
  "name": "hal-desk",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start-production.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:android": "npm --prefix android test",
    "test:ui": "node tests/ui.mjs",
    "test:web-engine": "node web-engine/tests/core.test.js && node --test web-engine/tests/analytics.test.js web-engine/tests/hedge.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "express": "^4.21.2",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "1.51.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.10"
  }
}
