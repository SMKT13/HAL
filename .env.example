PORT=3000
# Required: a separate, long random private viewer key. Never use the Upstox token here.
HAL_VIEWER_KEY=
UPSTOX_ACCESS_TOKEN=
# Optional server-side AI. Leave blank to keep AI disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit opt-in to search-grounded AI, subject to the configured account's quota/pricing.
HAL_AI_SEARCH=0
HAL_AI_HOURLY_LIMIT=20
# Set your public HTTPS origin behind a reverse proxy, e.g. https://your-service.onrender.com
HAL_PUBLIC_ORIGIN=
